<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <!-- System Security Event Pill -->
    <TextView
        android:id="@+id/tvSystemMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bubble_system"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/pigeon_primary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Peer / User Chat Bubble Container -->
    <LinearLayout
        android:id="@+id/layoutChatBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_incoming"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peer"
            android:textColor="@color/pigeon_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSharedImage"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="Encrypted Shared Image"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Hello"
            android:textColor="@color/pigeon_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMessageMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="12:00 • E2EE"
            android:textColor="@color/pigeon_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>
